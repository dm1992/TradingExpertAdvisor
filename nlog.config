<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  
  <targets>
    <target name="console" xsi:type="Console" layout="${longdate} ${level:uppercase=true} ${callsite:className=true} ${message} ${exception:format=ToString}" />
    <target name="file" xsi:type="File" fileName="${basedir}/logs/log_${shortdate}.txt"
            layout="${longdate} ${level:uppercase=true} ${callsite:className=true:includeNamespace=false} ${message} ${exception:format=ToString}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="console" />
    <logger name="*" minlevel="Debug" writeTo="file" />
  </rules>

</nlog>